<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Banco UPTC · Cajero Java + COBOL</title>
<style>
  :root {
    --azul: #1f3b73; --azul-claro: #e8eef9; --verde: #1e7d46; --rojo: #b3261e;
    --gris: #6b7280; --borde: #d9dee7; --fondo: #f4f6fa;
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "Segoe UI", system-ui, sans-serif; background: var(--fondo); color: #1c1f26; }
  header { background: var(--azul); color: #fff; padding: 18px 24px; }
  header h1 { margin: 0; font-size: 1.25rem; }
  header p { margin: 4px 0 0; font-size: .85rem; opacity: .8; }
  main { max-width: 760px; margin: 24px auto; padding: 0 16px; display: grid; gap: 16px; }
  .tarjeta { background: #fff; border: 1px solid var(--borde); border-radius: 10px; padding: 20px; }
  .tarjeta h2 { margin: 0 0 12px; font-size: 1rem; color: var(--azul); }
  label { font-size: .85rem; color: var(--gris); display: block; margin-bottom: 6px; }
  select, input[type=number] { width: 100%; padding: 10px 12px; font-size: 1rem; border: 1px solid var(--borde); border-radius: 8px; background: #fff; }
  .usuario-info { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; flex-wrap: wrap; margin-top: 16px; }
  .nombre { font-size: 1.1rem; font-weight: 600; }
  .etiqueta { color: var(--gris); font-size: .85rem; }
  .saldo { font-size: 2.2rem; font-weight: 700; font-variant-numeric: tabular-nums; text-align: right; }
  .contadores { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 16px; }
  .contador { background: var(--fondo); border-radius: 8px; padding: 10px; text-align: center; }
  .contador b { display: block; font-size: 1.3rem; }
  .contador span { font-size: .8rem; color: var(--gris); }
  form { display: flex; gap: 8px; flex-wrap: wrap; }
  form input { flex: 1; min-width: 160px; width: auto; }
  button { padding: 10px 16px; font-size: .95rem; border: 0; border-radius: 8px; cursor: pointer; background: var(--azul); color: #fff; }
  button:disabled { opacity: .6; cursor: wait; }
  .rapidos { display: flex; gap: 6px; margin-top: 10px; flex-wrap: wrap; }
  .rapidos button { background: var(--azul-claro); color: var(--azul); padding: 6px 12px; font-size: .85rem; }
  .mensaje { margin-top: 12px; padding: 10px 12px; border-radius: 8px; font-size: .9rem; display: none; }
  .mensaje.ok { display: block; background: #e6f4ec; color: var(--verde); }
  .mensaje.error { display: block; background: #fbe9e7; color: var(--rojo); }
  table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  th, td { text-align: left; padding: 8px 6px; border-bottom: 1px solid var(--borde); }
  th { color: var(--gris); font-weight: 600; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .chip { padding: 2px 8px; border-radius: 999px; font-size: .78rem; }
  .chip.ok { background: #e6f4ec; color: var(--verde); }
  .chip.no { background: #fbe9e7; color: var(--rojo); }
  .vacio { color: var(--gris); text-align: center; padding: 12px; }
</style>
</head>
<body>
<header>
  <h1>Banco UPTC · Cajero</h1>
  <p>Interfaz Spring Boot · retiro calculado en COBOL (RETIRAR-DINERO vía JNA) · datos en banco.json</p>
</header>

<main>
  <section class="tarjeta">
    <label for="selectorUsuario">Usuario</label>
    <select id="selectorUsuario"><option>Cargando…</option></select>

    <div class="usuario-info">
      <div>
        <div class="nombre" id="nombre">—</div>
        <div class="etiqueta" id="telefono"></div>
      </div>
      <div>
        <div class="etiqueta" style="text-align:right">Saldo actual</div>
        <div class="saldo" id="saldo">—</div>
      </div>
    </div>

    <div class="contadores">
      <div class="contador"><b id="cntExitosos">0</b><span>Retiros exitosos</span></div>
      <div class="contador"><b id="cntRechazados">0</b><span>Rechazados</span></div>
      <div class="contador"><b id="cntTotal">0</b><span>Movimientos</span></div>
    </div>
  </section>

  <section class="tarjeta">
    <h2>Retirar dinero</h2>
    <form id="formRetiro">
      <input type="number" id="monto" min="0.01" step="0.01" placeholder="Monto a retirar" required>
      <button type="submit" id="btnRetirar">Retirar</button>
    </form>
    <div class="rapidos">
      <button type="button" data-monto="50">$50</button>
      <button type="button" data-monto="100">$100</button>
      <button type="button" data-monto="300">$300</button>
      <button type="button" data-monto="600">$600</button>
    </div>
    <div class="mensaje" id="mensaje"></div>
  </section>

  <section class="tarjeta">
    <h2>Historial del usuario</h2>
    <table>
      <thead><tr><th>Fecha</th><th>Tipo</th><th>Estado</th><th class="num">Monto</th><th class="num">Saldo</th></tr></thead>
      <tbody id="historial"><tr><td colspan="5" class="vacio">Sin movimientos</td></tr></tbody>
    </table>
  </section>
</main>

<script>
  const API = "/api/usuarios";
  const fmt = new Intl.NumberFormat("es-CO", { style: "currency", currency: "COP", minimumFractionDigits: 2 });
  const $ = id => document.getElementById(id);

  let usuarios = [];        // lista que viene del servidor
  let usuarioActual = null; // id del usuario seleccionado

  // Evita que un nombre con caracteres especiales rompa el HTML
  const esc = s => String(s ?? "").replace(/[&<>"']/g, c =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

  function mostrarMensaje(texto, ok) {
    const m = $("mensaje");
    m.textContent = texto;
    m.className = "mensaje " + (ok ? "ok" : "error");
  }
  function ocultarMensaje() { $("mensaje").className = "mensaje"; }

  // ---------- Selector de usuarios ----------
  function pintarSelector() {
    $("selectorUsuario").innerHTML = usuarios.map(u =>
      `<option value="${u.id}" ${u.id === usuarioActual ? "selected" : ""}>
         ${esc(u.nombre)} ${esc(u.apellido)} — ${fmt.format(u.saldo)}
       </option>`).join("");
  }

  // ---------- Datos del usuario seleccionado ----------
  function pintarUsuario(u) {
    $("nombre").textContent = `${u.nombre} ${u.apellido}`;
    $("telefono").textContent = "Tel. " + (u.telefono ?? "");
    $("saldo").textContent = fmt.format(u.saldo);

    const historial = u.historial ?? [];
    $("cntExitosos").textContent   = historial.filter(m => m.tipo === "RETIRO" && m.estado === "EXITOSA").length;
    $("cntRechazados").textContent = historial.filter(m => m.estado === "RECHAZADA").length;
    $("cntTotal").textContent      = historial.length;

    const tbody = $("historial");
    if (historial.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" class="vacio">Sin movimientos</td></tr>';
      return;
    }
    // El historial se guarda en orden de llegada: invertido = más reciente primero
    const ordenado = [...historial].reverse();
    tbody.innerHTML = ordenado.map(m => `
      <tr>
        <td>${new Date(m.fecha).toLocaleString("es-CO")}</td>
        <td>${esc(m.tipo)}</td>
        <td><span class="chip ${m.estado === "EXITOSA" ? "ok" : "no"}">${m.estado === "EXITOSA" ? "Exitosa" : "Rechazada"}</span></td>
        <td class="num">${fmt.format(m.monto)}</td>
        <td class="num">${fmt.format(m.saldoResultante)}</td>
      </tr>`).join("");
  }

  // Reemplaza en la lista local el usuario que devolvió el servidor
  function actualizarLocal(u) {
    const i = usuarios.findIndex(x => x.id === u.id);
    if (i >= 0) usuarios[i] = u; else usuarios.push(u);
    pintarSelector();
    if (u.id === usuarioActual) pintarUsuario(u);
  }

  async function cargarUsuarios() {
    try {
      const r = await fetch(API);
      if (!r.ok) throw new Error();
      usuarios = await r.json();
      if (usuarios.length === 0) {
        $("selectorUsuario").innerHTML = "<option>No hay usuarios</option>";
        return;
      }
      // Recordar el último usuario elegido (si sigue existiendo)
      let guardado = null;
      try { guardado = Number(localStorage.getItem("usuarioActual")); } catch (e) {}
      usuarioActual = usuarios.some(u => u.id === guardado) ? guardado : usuarios[0].id;
      pintarSelector();
      pintarUsuario(usuarios.find(u => u.id === usuarioActual));
    } catch (e) {
      mostrarMensaje("No se pudo conectar con el servidor", false);
    }
  }

  $("selectorUsuario").addEventListener("change", async e => {
    usuarioActual = Number(e.target.value);
    try { localStorage.setItem("usuarioActual", usuarioActual); } catch (err) {}
    ocultarMensaje();
    // Se pide al servidor para mostrar siempre lo que hay en banco.json
    try {
      const r = await fetch(`${API}/${usuarioActual}`);
      const data = await r.json();
      if (!r.ok) return mostrarMensaje(data.error || "Error al cargar el usuario", false);
      actualizarLocal(data);
    } catch (err) {
      mostrarMensaje("No se pudo conectar con el servidor", false);
    }
  });

  // ---------- Retiro ----------
  async function retirar(monto) {
    if (usuarioActual === null) return;
    $("btnRetirar").disabled = true;
    try {
      const r = await fetch(`${API}/${usuarioActual}/retirar`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ monto })
      });
      const data = await r.json();
      if (!r.ok) {
        mostrarMensaje(data.error || "Error en la solicitud", false);
        return;
      }
      // El servidor devuelve el usuario ya actualizado y guardado
      actualizarLocal(data);
      const ultimo = data.historial[data.historial.length - 1];
      if (ultimo && ultimo.estado === "EXITOSA") {
        mostrarMensaje(`Retiro exitoso de ${fmt.format(monto)}`, true);
        $("monto").value = "";
      } else {
        mostrarMensaje(`Retiro de ${fmt.format(monto)} rechazado: fondos insuficientes`, false);
      }
    } catch (e) {
      mostrarMensaje("No se pudo conectar con el servidor", false);
    } finally {
      $("btnRetirar").disabled = false;
    }
  }

  $("formRetiro").addEventListener("submit", e => {
    e.preventDefault();
    retirar(parseFloat($("monto").value));
  });
  document.querySelectorAll(".rapidos button").forEach(b =>
    b.addEventListener("click", () => retirar(parseFloat(b.dataset.monto))));

  cargarUsuarios();
</script>
</body>
</html>
