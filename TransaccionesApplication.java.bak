package uptc.banco.transacciones;

import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;

import uptc.banco.transacciones.Service.LibCob;
import uptc.banco.transacciones.Service.Transaccion;
import com.sun.jna.ptr.DoubleByReference;
import com.sun.jna.ptr.IntByReference;

@SpringBootApplication
public class TransaccionesApplication {

    static {
        System.setProperty("jna.library.path", "C:/msys64/ucrt64/bin;.;..");
    }

	public static void main(String[] args) {
        LibCob.INSTANCE.cob_init(0, null);
		SpringApplication.run(TransaccionesApplication.class, args);
		double saldoActual = 1000.00;
        System.out.println("Saldo inicial:" + saldoActual);
        saldoActual = procesarRetiro(saldoActual, 300.00);
        saldoActual = procesarRetiro(saldoActual, 600.00);
        saldoActual = procesarRetiro(saldoActual, 200.00);
	}
	private static double procesarRetiro(double saldoActual, double monto) {
        DoubleByReference refBalance = new DoubleByReference(saldoActual);
        DoubleByReference refMonto = new DoubleByReference(monto);
        DoubleByReference refNuevoBalance = new DoubleByReference(0.0);
        IntByReference refEstado = new IntByReference(0);
        Transaccion.INSTANCE.retirar_dinero(refBalance, refMonto, refNuevoBalance, refEstado);

        if (refEstado.getValue() == 0) {
            double nuevoSaldo = refNuevoBalance.getValue();
            System.out.printf("Retiro de $%.2f EXITOSO. Saldo actual: $%.2f%n", monto, nuevoSaldo);
            return nuevoSaldo;
        } else {
            System.out.printf("Retiro de $%.2f RECHAZADO: Fondos insuficientes. Saldo actual: $%.2f%n", monto, saldoActual);
            return saldoActual;
        }
    }
}
